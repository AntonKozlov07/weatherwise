# Copy to .env.local and fill in. Nothing here may be prefixed NEXT_PUBLIC_
# except the VAPID public key, which is designed to be public. Every vendor
# request goes through a route handler under app/api/.
#
# Mirror all of these into the Vercel project settings before deploying.

# ---------------------------------------------------------------------------
# Weather. Every weather field in the app comes from this one key:
#   One Call 4.0   current, hourly, daily, minutely, alerts  (paid subscription)
#   Geocoding      city search and place names               (free tier)
#   Air Quality    AQI                                       (free tier)
#   Weather Maps   wind tiles, version 1.0                   (free tier)
OPENWEATHER_API_KEY=

# News provider, for the Explore page only. Not part of the weather layer.
NEWS_API_KEY=

# ---------------------------------------------------------------------------
# Severe weather push notifications.

# Postgres connection string. Vercel Postgres and Neon both provide one.
# Used only for the push subscriptions table; preferences stay in localStorage.
DATABASE_URL=

# VAPID pair. Generate once with:  npx web-push generate-vapid-keys
# The public key is sent to the browser by design; the private key never is.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact address for push services, as a mailto: URL. Required by the spec so
# a push provider can reach you about a misbehaving sender.
VAPID_SUBJECT=mailto:you@example.com

# Shared secret for the scheduled alert poll. Vercel Cron sends it as a bearer
# token automatically; an external scheduler must send the same header.
# The endpoint refuses to run at all when this is unset.
CRON_SECRET=
