# Copy to .env.local and fill in. Never prefix either of these with
# NEXT_PUBLIC_, and never call these vendors from a client component. Every
# request goes through a route handler under app/api/.
#
# Mirror both into the Vercel project settings before deploying.

# OpenWeatherMap. Every weather field in the app comes from this one key:
#   One Call     current, hourly, daily, alerts   (needs a One Call subscription)
#   Geocoding    city search and place names      (free tier)
#   Air Quality  AQI                              (free tier)
#   Weather Maps precipitation and wind tiles     (free tier, version 1.0)
OPENWEATHER_API_KEY=

# News provider, for the Explore page only. Not part of the weather migration.
NEWS_API_KEY=
