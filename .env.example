# Copy to .env.local and fill in. Never prefix any of these with NEXT_PUBLIC_,
# and never call these vendors from a client component. Every request goes
# through a route handler under app/api/.
#
# Mirror all three into the Vercel project settings before deploying.

# WeatherAPI.com. Current conditions, hourly, AQI, astronomy, alerts, city search.
WEATHER_API_KEY=

# OpenWeatherMap. Weather Maps 1.0 wind_new tiles only.
OPENWEATHER_API_KEY=

# News provider. Identify the provider from the key format and response shape
# before writing the Explore page (phase 6).
NEWS_API_KEY=
